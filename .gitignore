## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results - الأولوية لمنع هذه المجلدات
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.obj
*.exe
*.pdb
*.user
*.suo
.vs/

# User-specific files
*.rsuser
*.userosscache
*.sln.docstates
*.userprefs

# Mono auto generated files
mono_crash.*

# .NET Core & Standard
project.lock.json
project.fragment.lock.json
artifacts/

# Visual Studio 2017/2019/2022 cache/options directory
.vs/
Generated\ Files/

# MSTest and NUnit results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml

# NuGet Packages
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# SQL Server files (Database)
*.mdf
*.ldf
*.ndf

# Node.js (if used in the project)
node_modules/
.ntvs_analysis.dat

# Windows temporary files
Thumbs.db
ehthumbs.db
Desktop.ini

# Fody - auto-generated XML schema
FodyWeavers.xsd